# Токен бота от @BotFather — обязателен.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Репозиторий хранилища и ветка.
VAULT_REPO_URL=https://github.com/TeamKait/KAIT20-INFO.git
VAULT_BRANCH=master

# Токен нужен только для приватного репозитория (fine-grained PAT, Contents: Read).
# GIT_TOKEN=github_pat_xxx

# Период обновления: 1h, 30m, 6h...
SYNC_INTERVAL=1h

# Ограничить бота конкретными чатами (id через запятую). Пусто — любой чат.
# ALLOWED_CHAT_IDS=-1001234567890

# debug | info | warn | error
LOG_LEVEL=info

# Куда клонировать хранилище. В Docker не задавайте — используется /data/vault.
# VAULT_DIR=./.vault

# Папка с картинками внутри vault (для фото преподавателей и заметок).
# IMAGES_DIR=Прочее/Картинки
